# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated split index (rebuilt during build)
/public/data/

# classification CSV (local work file)
scripts/classifications.csv

# normalized intermediate data (rebuilt by normalize-works.ts)
/data/normalized/

# similar-works (rebuilt on every build; generatedAt timestamp changes only)
/data/similar-works/
.github-token
